// api.js - Updated API Client with Threat Intelligence endpoints

import axios from 'axios';

const API_URL = process.env.REACT_APP_API_URL || 'http://localhost:5000/api';

const api = axios.create({
  baseURL: API_URL,
  timeout: 10000,
  headers: {
    'Content-Type': 'application/json'
  }
});

// ========== Basic Endpoints ==========
export const getHealth = () => api.get('/health');
export const getStats = () => api.get('/stats');
export const getRecentAttacks = (limit = 50) => api.get(`/attacks/recent?limit=${limit}`);
export const getAttacksByCountry = () => api.get('/attacks/by-country');
export const getMapData = () => api.get('/attacks/map');
export const getTopCredentials = () => api.get('/attacks/credentials');
export const getTopCommands = () => api.get('/attacks/commands');
export const getTimeline = (days = 7) => api.get(`/attacks/timeline?days=${days}`);
export const importLogs = () => api.post('/import-logs');

// ========== Threat Intelligence Endpoints ==========
export const getThreatAlerts = () => api.get('/threat-intelligence/alerts');
export const getBruteForceDetection = (minutes = 5, threshold = 10) => 
  api.get(`/threat-intelligence/bruteforce?minutes=${minutes}&threshold=${threshold}`);
export const getDefaultCredentials = () => api.get('/threat-intelligence/default-credentials');
export const getMaliciousCommands = () => api.get('/threat-intelligence/malicious-commands');
export const getCryptoMiners = () => api.get('/threat-intelligence/crypto-miners');
export const getReconnaissance = () => api.get('/threat-intelligence/reconnaissance');
export const getPersistence = () => api.get('/threat-intelligence/persistence');
export const getMITREMapping = () => api.get('/threat-intelligence/mitre-mapping');
export const getThreatSummary = () => api.get('/threat-intelligence/summary');

export default api;