// Get MITRE ATT&CK mapping
app.get('/api/threat-intelligence/mitre-mapping', async (req, res) => {
  try {
    const [
      bruteForce,
      defaultCreds,
      maliciousCommands,
      cryptoMiners,
      reconnaissance,
      persistence
    ] = await Promise.all([
      detectSSHBruteForce(),
      detectDefaultCredentials(),
      detectMaliciousCommands(),
      detectCryptoMiners(),
      detectReconnaissanceActivity(),
      detectPersistenceMechanisms()
    ]);

    const mitreMapping = [
      {
        technique: 'T1110.001',
        name: 'Brute Force: Password Guessing',
        tactic: 'Credential Access',
        detections: bruteForce.length
      },
      {
        technique: 'T1078.001',
        name: 'Valid Accounts: Default Accounts',
        tactic: 'Persistence',
        detections: defaultCreds.length
      },
      {
        technique: 'T1059',
        name: 'Command and Scripting Interpreter',
        tactic: 'Execution',
        detections: maliciousCommands.reduce((sum, r) => sum + r.count, 0)
      },
      {
        technique: 'T1496',
        name: 'Resource Hijacking',
        tactic: 'Impact',
        detections: cryptoMiners.length
      },
      {
        technique: 'T1046',
        name: 'Network Service Discovery',
        tactic: 'Discovery',
        detections: reconnaissance.length
      },
      {
        technique: 'T1053.003',
        name: 'Scheduled Task/Job: Cron',
        tactic: 'Persistence',
        detections: persistence.length
      }
    ];

    res.json({
      framework: 'MITRE ATT&CK',
      totalTechniques: mitreMapping.length,
      totalDetections: mitreMapping.reduce((sum, m) => sum + m.detections, 0),
      techniques: mitreMapping.filter(m => m.detections > 0)
    });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Get threat intelligence summary
app.get('/api/threat-intelligence/summary', async (req, res) => {
  try {
    const [
      totalAttacks,
      bruteForce,
      cryptoMiners,
      maliciousCommands,
      topAttackers
    ] = await Promise.all([
      Attack.countDocuments(),
      detectSSHBruteForce(),
      detectCryptoMiners(),
      detectMaliciousCommands(),
      Attack.aggregate([
        { $match: { event: 'auth' } },
        { $group: { _id: '$ip', attacks: { $sum: 1 }, country: { $first: '$country' } } },
        { $sort: { attacks: -1 } },
        { $limit: 5 }
      ])
    ]);

    res.json({
      totalAttacks,
      criticalThreats: {
        bruteForceIPs: bruteForce.length,
        cryptoMiners: cryptoMiners.length,
        maliciousCommands: maliciousCommands.reduce((sum, r) => sum + r.count, 0)
      },
      topAttackers: topAttackers.map(a => ({
        ip: a._id,
        attacks: a.attacks,
        country: a.country
      })),
      riskLevel: bruteForce.length > 5 || cryptoMiners.length > 0 ? 'HIGH' : 'MEDIUM'
    });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

