//server.js - Complete Backend with YARA and Sigma Integration

require('dotenv').config();
const express = require('express');
const cors = require('cors');
const connectDB = require('./database');
const Attack = require('./Attack');
const importLogs = require('./importLogs');

const app = express();

// Middleware
app.use(cors());
app.use(express.json());

// Connect to database
connectDB();

// ========== HELPER FUNCTIONS ==========

// Sigma Detection Functions
const detectSSHBruteForce = async (minutes = 5, threshold = 10) => {
  const timeThreshold = new Date(Date.now() - minutes * 60 * 1000);
  
  const bruteForceIPs = await Attack.aggregate([
    {
      $match: {
        event: 'auth',
        timestamp: { $gte: timeThreshold }
      }
    },
    {
      $group: {
        _id: '$ip',
        attempts: { $sum: 1 },
        usernames: { $addToSet: '$username' },
        passwords: { $addToSet: '$password' },
        lastAttempt: { $max: '$timestamp' }
      }
    },
    {
      $match: {
        attempts: { $gte: threshold }
      }
    },
    {
      $project: {
        ip: '$_id',
        attempts: 1,
        usernames: 1,
        passwords: 1,
        lastAttempt: 1,
        _id: 0
      }
    },
    { $sort: { attempts: -1 } }
  ]);

  return bruteForceIPs;
};

const detectDefaultCredentials = async () => {
  const defaultCreds = [
    { username: 'root', password: 'root' },
    { username: 'admin', password: 'admin' },
    { username: 'root', password: 'password' },
    { username: 'admin', password: 'password' },
    { username: 'root', password: '123456' },
    { username: 'test', password: 'test' },
    { username: 'user', password: 'user' },
    { username: 'ubuntu', password: 'ubuntu' }
  ];

  const results = [];
  for (const cred of defaultCreds) {
    const count = await Attack.countDocuments({
      event: 'auth',
      username: cred.username,
      password: cred.password
    });
    
    if (count > 0) {
      const attempts = await Attack.find({
        event: 'auth',
        username: cred.username,
        password: cred.password
      })
      .sort({ timestamp: -1 })
      .limit(5)
      .select('ip timestamp country');

      results.push({
        username: cred.username,
        password: cred.password,
        attempts: count,
        recentAttempts: attempts
      });
    }
  }

  return results;
};

const detectMaliciousCommands = async () => {
  const maliciousPatterns = [
    { pattern: 'wget', category: 'download', severity: 'high' },
    { pattern: 'curl', category: 'download', severity: 'high' },
    { pattern: 'chmod +x', category: 'execution', severity: 'critical' },
    { pattern: '/dev/tcp/', category: 'reverse_shell', severity: 'critical' },
    { pattern: 'nc -e', category: 'reverse_shell', severity: 'critical' },
    { pattern: 'python -c', category: 'code_execution', severity: 'high' },
    { pattern: 'perl -e', category: 'code_execution', severity: 'high' },
    { pattern: 'base64', category: 'obfuscation', severity: 'medium' },
    { pattern: '/etc/passwd', category: 'reconnaissance', severity: 'high' },
    { pattern: '/etc/shadow', category: 'credential_access', severity: 'critical' }
  ];

  const results = [];
  for (const { pattern, category, severity } of maliciousPatterns) {
    const matches = await Attack.find({
      command: { $regex: pattern, $options: 'i' },
      command: { $ne: null }
    })
    .sort({ timestamp: -1 })
    .limit(10)
    .select('command ip timestamp country sessionId');

    if (matches.length > 0) {
      results.push({
        pattern,
        category,
        severity,
        count: matches.length,
        matches: matches.map(m => ({
          command: m.command,
          ip: m.ip,
          timestamp: m.timestamp,
          country: m.country,
          sessionId: m.sessionId
        }))
      });
    }
  }

  return results;
};

const detectCryptoMiners = async () => {
  const minerKeywords = [
    'xmrig',
    'minerd',
    'cpuminer',
    'stratum+tcp',
    'monero',
    'pool.minergate',
    'supportxmr',
    '--donate-level'
  ];

  const regexPattern = minerKeywords.join('|');
  
  const miners = await Attack.find({
    command: { $regex: regexPattern, $options: 'i' }
  })
  .sort({ timestamp: -1 })
  .select('command ip timestamp country sessionId');

  return miners.map(m => ({
    command: m.command,
    ip: m.ip,
    timestamp: m.timestamp,
    country: m.country,
    sessionId: m.sessionId
  }));
};

const detectReconnaissanceActivity = async () => {
  const reconCommands = [
    'uname',
    'whoami',
    'id',
    'cat /etc/passwd',
    'cat /etc/issue',
    'cat /proc/version',
    'netstat',
    'ifconfig',
    'ip addr',
    'ps aux',
    'ls -la'
  ];

  const regexPattern = reconCommands.join('|');
  
  const recon = await Attack.aggregate([
    {
      $match: {
        command: { $regex: regexPattern, $options: 'i' }
      }
    },
    {
      $group: {
        _id: '$sessionId',
        commands: { $push: '$command' },
        ip: { $first: '$ip' },
        country: { $first: '$country' },
        timestamp: { $first: '$timestamp' },
        commandCount: { $sum: 1 }
      }
    },
    {
      $match: {
        commandCount: { $gte: 2 }
      }
    },
    {
      $sort: { commandCount: -1 }
    },
    {
      $limit: 20
    }
  ]);

  return recon;
};

const detectPersistenceMechanisms = async () => {
  const persistencePatterns = [
    'crontab',
    '/etc/cron',
    '* * * * *',
    '/etc/rc.local',
    '/etc/systemd/system',
    '.bashrc',
    '.profile',
    'authorized_keys'
  ];

  const regexPattern = persistencePatterns.join('|');
  
  const persistence = await Attack.find({
    command: { $regex: regexPattern, $options: 'i' }
  })
  .sort({ timestamp: -1 })
  .limit(20)
  .select('command ip timestamp country sessionId');

  return persistence;
};

// ========== API ROUTES ==========

// Health check
app.get('/api/health', (req, res) => {
  res.json({ 
    status: 'OK', 
    timestamp: new Date(),
    message: 'Honeypot API is running',
    features: ['YARA Detection', 'Sigma Rules', 'Threat Intelligence']
  });
});

// Get statistics
app.get('/api/stats', async (req, res) => {
  try {
    const [total, authAttempts, uniqueIps, sessions, maliciousCommands] = await Promise.all([
      Attack.countDocuments(),
      Attack.countDocuments({ event: 'auth' }),
      Attack.distinct('ip').then(ips => ips.filter(ip => ip).length),
      Attack.countDocuments({ event: 'session_start', username: { $ne: 'N/A' } }),
      Attack.countDocuments({ command: { $ne: null } })
    ]);

    res.json({
      totalAttacks: total,
      authAttempts: authAttempts,
      uniqueIps: uniqueIps,
      successfulSessions: sessions,
      maliciousCommands: maliciousCommands
    });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Get recent attacks
app.get('/api/attacks/recent', async (req, res) => {
  try {
    const limit = parseInt(req.query.limit) || 50;
    
    const attacks = await Attack.find({ event: 'auth' })
      .sort({ timestamp: -1 })
      .limit(limit)
      .select('timestamp ip username password country city');

    res.json(attacks);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Get attacks by country
app.get('/api/attacks/by-country', async (req, res) => {
  try {
    const countries = await Attack.aggregate([
      { $match: { event: 'auth', country: { $ne: 'Unknown' } } },
      { $group: { _id: '$country', count: { $sum: 1 } } },
      { $sort: { count: -1 } },
      { $limit: 10 },
      { $project: { _id: 0, country: '$_id', count: 1 } }
    ]);

    res.json(countries);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Get map data (for visualization)
app.get('/api/attacks/map', async (req, res) => {
  try {
    const mapData = await Attack.aggregate([
      { 
        $match: { 
          event: 'auth',
          latitude: { $ne: 0 },
          longitude: { $ne: 0 }
        } 
      },
      { 
        $group: {
          _id: { lat: '$latitude', lon: '$longitude', country: '$country' },
          count: { $sum: 1 },
          city: { $first: '$city' }
        }
      },
      {
        $project: {
          _id: 0,
          latitude: '$_id.lat',
          longitude: '$_id.lon',
          country: '$_id.country',
          city: '$city',
          count: 1
        }
      }
    ]);

    res.json(mapData);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Get top credentials
app.get('/api/attacks/credentials', async (req, res) => {
  try {
    const credentials = await Attack.aggregate([
      { $match: { event: 'auth', username: { $exists: true } } },
      { 
        $group: { 
          _id: { username: '$username', password: '$password' },
          count: { $sum: 1 }
        }
      },
      { $sort: { count: -1 } },
      { $limit: 20 },
      {
        $project: {
          _id: 0,
          username: '$_id.username',
          password: '$_id.password',
          count: 1
        }
      }
    ]);

    res.json(credentials);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Get top commands
app.get('/api/attacks/commands', async (req, res) => {
  try {
    const commands = await Attack.aggregate([
      { $match: { command: { $exists: true, $ne: null } } },
      { $group: { _id: '$command', count: { $sum: 1 } } },
      { $sort: { count: -1 } },
      { $limit: 20 },
      { $project: { _id: 0, command: '$_id', count: 1 } }
    ]);

    res.json(commands);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Get attack timeline (last 7 days)
app.get('/api/attacks/timeline', async (req, res) => {
  try {
    const days = parseInt(req.query.days) || 7;
    const startDate = new Date();
    startDate.setDate(startDate.getDate() - days);

    const timeline = await Attack.aggregate([
      { $match: { timestamp: { $gte: startDate }, event: 'auth' } },
      {
        $group: {
          _id: { $dateToString: { format: '%Y-%m-%d', date: '$timestamp' } },
          count: { $sum: 1 }
        }
      },
      { $sort: { _id: 1 } },
      { $project: { _id: 0, date: '$_id', attacks: '$count' } }
    ]);

    res.json(timeline);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// Import logs endpoint
app.post('/api/import-logs', async (req, res) => {
  try {
    console.log('Starting log import...');
    const result = await importLogs();
    
    res.json({
      success: true,
      message: `Imported ${result.imported} logs`,
      imported: result.imported,
      skipped: result.skipped
    });
  } catch (error) {
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

// ========== SIGMA DETECTION ENDPOINTS ==========

// Get all threat intelligence alerts
app.get('/api/threat-intelligence/alerts', async (req, res) => {
  try {
    const [
      bruteForce,
      defaultCreds,
      maliciousCommands,
      cryptoMiners,
      reconnaissance,
      persistence
    ] = await Promise.all([
      detectSSHBruteForce(),
      detectDefaultCredentials(),
      detectMaliciousCommands(),
      detectCryptoMiners(),
      detectReconnaissanceActivity(),
      detectPersistenceMechanisms()
    ]);

    const report = {
      timestamp: new Date(),
      summary: {
        totalAlerts: bruteForce.length + defaultCreds.length + 
                    maliciousCommands.length + cryptoMiners.length +
                    reconnaissance.length + persistence.length,
        criticalAlerts: maliciousCommands.filter(m => m.severity === 'critical').length +
                       cryptoMiners.length,
        highAlerts: bruteForce.length + 
                   maliciousCommands.filter(m => m.severity === 'high').length
      },
      alerts: {
        bruteForce: {
          count: bruteForce.length,
          severity: 'high',
          mitre: 'T1110.001',
          data: bruteForce
        },
        defaultCredentials: {
          count: defaultCreds.length,
          severity: 'medium',
          mitre: 'T1078.001',
          data: defaultCreds
        },
        maliciousCommands: {
          count: maliciousCommands.length,
          severity: 'high',
          mitre: 'T1059',
          data: maliciousCommands
        },
        cryptoMiners: {
          count: cryptoMiners.length,
          severity: 'critical',
          mitre: 'T1496',
          data: cryptoMiners
        },
        reconnaissance: {
          count: reconnaissance.length,
          severity: 'medium',
          mitre: 'T1046',
          data: reconnaissance
        },
        persistence: {
          count: persistence.length,
          severity: 'high',
          mitre: 'T1053.003',
          data: persistence
        }
      }
    };

    res.json(report);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// SSH Brute Force Detection
app.get('/api/threat-intelligence/bruteforce', async (req, res) => {
  try {
    const minutes = parseInt(req.query.minutes) || 5;
    const threshold = parseInt(req.query.threshold) || 10;
    
    const results = await detectSSHBruteForce(minutes, threshold);
    
    res.json({
      detection: 'SSH Brute Force Attack',
      mitre: 'T1110.001',
      severity: 'high',
      count: results.length,
      timeframe: `${minutes} minutes`,
      threshold: threshold,
      results: results
    });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

